{
  "name": "open-hr",
  "private": true,
  "description": "Open Hybrid RAID: Synology Hybrid RAID for any Linux box.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "check": "biome check --error-on-warnings . && turbo run typecheck test",
    "clean": "rm -rf packages/*/dist packages/*/coverage .turbo packages/*/.turbo"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "turbo": "^2.11.10"
  }
}
