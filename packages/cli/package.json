{
  "name": "@ohr/cli",
  "version": "0.1.0",
  "private": true,
  "description": "The ohr command line tool.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ohr": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --passWithNoTests --coverage"
  },
  "dependencies": {
    "@ohr/rpc": "workspace:*",
    "@ohr/shared": "workspace:*"
  },
  "devDependencies": {
    "@ohr/core": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
